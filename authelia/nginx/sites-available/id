# KM0 Authelia portal — id.km0digital.com
# Proxy al contenedor Authelia (127.0.0.1:9091) + skin KM0 (CSS/title inject).

server {
    listen 80;
    listen [::]:80;
    server_name id.km0digital.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name id.km0digital.com;

    ssl_certificate     /etc/letsencrypt/live/id.km0digital.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/id.km0digital.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 2m;

    # KM0 skin assets (served by nginx, not Authelia)
    location = /km0-authelia.css {
        alias /opt/opencloud/authelia/nginx/km0-authelia.css;
        default_type text/css;
        expires 1h;
        add_header Cache-Control "public";
    }

    location = /km0-title.js {
        alias /opt/opencloud/authelia/nginx/km0-title.js;
        default_type application/javascript;
        expires 1h;
        add_header Cache-Control "public";
    }

    # Logout bridge: POST /api/logout (clear HttpOnly session) then redirect.
    location = /km0-logout {
        alias /opt/opencloud/authelia/nginx/km0-logout.html;
        default_type text/html;
        add_header Cache-Control "no-store";
    }

    location / {
        proxy_pass http://127.0.0.1:9091;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Allow sub_filter on HTML (disable upstream gzip for this hop)
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '</head>' '<link rel="stylesheet" href="/km0-authelia.css" /><script src="/km0-title.js"></script></head>';
        sub_filter 'content="Authelia login portal for your apps"' 'content="Inicio de sesión KM0 — Kilómetro 0 Digital"';
        sub_filter '<title>Login - Authelia</title>' '<title>Kilómetro 0 Digital — Iniciar sesión</title>';
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
